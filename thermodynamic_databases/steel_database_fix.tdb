 PHASE PYRR %  2 1   1 ! 

$(Cu,Fe)S pyrrhotite, hexagonal close-packed, 

$for thermodynamic equilibrium calculations only. 

$>> 1 !

    CONSTITUENT PYRR  : CU,FE,VA : S :  !

PARAMETER G(PYRR,CU:S;


PARAMETER G(PYRR,FE:S;

   -18.19*T+1.78*T*LN(T);


PARAMETER G(PYRR,VA:S;


$----------------------Interaction parameters----------------------

PARAMETER L(PYRR,CU,FE:S;


PARAMETER L(PYRR,FE,VA:S;


PARAMETER L(PYRR,FE,VA:S;


$

$###########################################################################

$                   THERMODYNAMIC PARAMETERS: TIS

$###########################################################################

$

 PHASE TIS %  2 1   1 ! 

$Minor role as precipitate in ultra-low carbon steel. 

$>> 1 !

    CONSTITUENT TIS  : TI : S :  !

PARAMETER G(TIS,TI:S;

   -87724-125.24*T;


$

$###########################################################################

$                   THERMODYNAMIC PARAMETERS: TI4C2S2

$###########################################################################

$

 PHASE TI4C2S2 %  3 4   2   2 ! 

$Main Ti-Carbosulfide precipitate in ultra-low carbon steel. 

$>> 2 !

    CONSTITUENT TI4C2S2  : TI : C : S :  !

PARAMETER G(TI4C2S2,TI:C:S;

  -449804-348*T;


$

$###########################################################################

$                   THERMODYNAMIC PARAMETERS: OXIDE PHASES

$###########################################################################

$

 TYPE_DEFINITION ( GES A_P_D CORUND MAGNETIC  -3.0    0.28 !

 PHASE CORUND  %(  2 2   3 ! $ corund-structured (Al,Cr,Fe)2O3 >> 3 !

   CONSTITUENT CORUND  :AL,CR%,FE%,NI : O :  !

PARAMETER G(CORUND,AL:O;


PARAMETER G(CORUND,CR:O;


PARAMETER G(CORUND,FE:O;


PARAMETER G(CORUND,NI:O;

+3*GHSEROO#;


PARAMETER L(CORUND,CR,FE:O;


PARAMETER L(CORUND,AL,CR:O;


PARAMETER L(CORUND,AL,FE:O;


PARAMETER L(CORUND,AL,NI:O;


PARAMETER TC(CORUND,CR:O;


PARAMETER BMAGN(CORUND,CR:O;


PARAMETER TC(CORUND,FE:O;


PARAMETER BMAGN(CORUND,FE:O;


$

 PHASE HALITE  %  2 1   1 ! $ halite-structured (Cr,Fe,Ni)O >> 3 !

   CONSTITUENT HALITE  :AL,CR,FE%,NI : O :  !

PARAMETER G(HALITE,AL:O;

+0.33333*GHSERAL#+200000;


PARAMETER G(HALITE,CR:O;

+0.33333*GHSERCR#+100000;


PARAMETER G(HALITE,FE:O;


PARAMETER G(HALITE,NI:O;


PARAMETER L(HALITE,AL,CR:O;


PARAMETER L(HALITE,AL,NI:O;


PARAMETER L(HALITE,AL,FE:O;


PARAMETER L(HALITE,CR,FE:O;


PARAMETER L(HALITE,CR,NI:O;


PARAMETER L(HALITE,FE,NI:O;


PARAMETER L(HALITE,FE,NI:O;


$

 PHASE HF1O2_M  %  2 0.33333  0.66667  ! $ monoclinic, 

$strengthening dispersoid >> 2 !

    CONSTITUENT HF1O2_M  :HF : O:  !

PARAMETER G(HF1O2_M,HF:O;


$

 PHASE HF1O2_T  %  2 0.33333  0.66667  ! $ tetragonal >> 1 !

    CONSTITUENT HF1O2_T  :HF : O:  !

PARAMETER G(HF1O2_T,HF:O;

 +2736-1.333333*T;


$

 PHASE HF1O2_C  %  2 0.33333  0.66667  ! $ cubic >> 1 !

    CONSTITUENT HF1O2_C  :HF : O:  !

PARAMETER G(HF1O2_C,HF:O;

 +6473.3333-2.66667*T;


$

 PHASE LA2O3_A  %  2 2   3 ! $ hexagonal, strengthening dispersoid >> 2 !

    CONSTITUENT LA2O3_A  :LA : O :  !

PARAMETER G(LA2O3_A,LA:O;


$

 PHASE LA2O3_H  %  2 2   3 ! $ ordered hexagonal >> 1 !

    CONSTITUENT LA2O3_H  :LA : O :  !

PARAMETER G(LA2O3_H,LA:O;


$

 PHASE LA2O3_C  %  2 2   3 ! $ cubic >> 1 !

    CONSTITUENT LA2O3_C  :LA : O :  !

PARAMETER G(LA2O3_C,LA:O;


$

 PHASE SIO2  %  2 1   2 ! $ Low Quartz >> 1 !

    CONSTITUENT SIO2  :SI : O :  !

PARAMETER G(SIO2,SI:O;


$

 PHASE SPINEL  %  3 1   2 4 ! $ Fe-Cr-Spinel >> 2 !

    CONSTITUENT SPINEL  :AL,CR,FE%,NI : AL,CR%,FE,NI : O :  !

PARAMETER G(SPINEL,CR:FE:O;

 -1200000+350*T-10*T*LN(T);


PARAMETER G(SPINEL,FE:FE:O;

 -1150000+440*T-10*T*LN(T);


PARAMETER G(SPINEL,NI:AL:O;

 -1900000+320*T+12*T*LN(T)-0.004*T**2;


PARAMETER G(SPINEL,CR:AL:O;

+4*GHSEROO#;


PARAMETER G(SPINEL,FE:AL:O;

+4*GHSEROO#-1975000+425*T-10*T*LN(T);


PARAMETER G(SPINEL,FE:NI:O;

+4*GHSEROO#-500000+325*T-10*T*LN(T);


PARAMETER G(SPINEL,NI:FE:O;

 -1000000+325*T-10*T*LN(T);


PARAMETER G(SPINEL,NI:CR:O;

 -1240000+300*T-10*T*LN(T);


PARAMETER G(SPINEL,CR:NI:O;

+4*GHSEROO#;


PARAMETER G(SPINEL,FE:CR:O;

 -1420000+425*T-10*T*LN(T);


PARAMETER G(SPINEL,NI:NI:O;


PARAMETER G(SPINEL,CR:CR:O;


PARAMETER G(SPINEL,AL:AL:O;


PARAMETER G(SPINEL,AL:CR:O;

 +4*GHSEROO#;


PARAMETER G(SPINEL,AL:FE:O;

 +4*GHSEROO#;


PARAMETER G(SPINEL,AL:NI:O;

 +4*GHSEROO#;


PARAMETER L(SPINEL,NI:CR,FE:O;


PARAMETER L(SPINEL,NI:AL,CR:O;


PARAMETER L(SPINEL,NI:AL,FE:O;


PARAMETER L(SPINEL,FE:AL,CR:O;


$

 PHASE TIO2  %  2 1   2 ! $ Note: fully oxidized compound 

$without oxygen vacancies >> 2 !

    CONSTITUENT TIO2  :TI : O :  !

PARAMETER G(TIO2,TI:O;

  -67156800*T**(-2)+1683920*T**(-1);


$

 PHASE TI2O3  %  2 2   3 ! $ >> 1 !

    CONSTITUENT TI2O3  :TI : O :  !

PARAMETER G(TI2O3,TI:O;


$

 PHASE TRID  %  2 1   2 ! $ Tridymite >> 1 !

    CONSTITUENT TRID  :SI : O :  !

PARAMETER G(TRID,SI:O;


$

 PHASE Y2O3_C  %  2 2   3 ! $ cubic Yttrium oxide, 

$strengthening dispersoid >> 2 !

    CONSTITUENT Y2O3_C  :Y : O :  !

PARAMETER G(Y2O3_C,Y:O;


$

 PHASE Y2O3_H  %  2 2   3 ! $ hexagonal Yttrium oxide, 

$strengthening dispersoid >> 2 !

    CONSTITUENT Y2O3_H  :Y : O :  !

PARAMETER G(Y2O3_H,Y:O;


$

 PHASE YALO3  %  3 1 1   3 ! $ strengthening dispersoid, 

$perovskite structure >> 2 !

    CONSTITUENT YALO3  :Y : AL : O :  !

PARAMETER G(YALO3,Y:AL:O;

 +0.5*GY2O3C#;


$

 PHASE Y4AL2O9  %  3 4 2   9 ! $ monoclinic strengthening dispersoid >> 2 !

    CONSTITUENT Y4AL2O9  :Y : AL : O :  !

PARAMETER G(Y4AL2O9,Y:AL:O;

  -0.01836*T**2+4310328.16*T**(-1);


$

 PHASE Y2TIO5  %  3 2 1   5 ! $ orthorhombic, strengthening dispersoid >> 2 !

    CONSTITUENT Y2TIO5  :Y : TI : O :  !

PARAMETER G(Y2TIO5,Y:TI:O;

 -184500+36.1*T;


$

 PHASE Y2TI2O7  %  3 2 2   7 ! $ pyrochlore structure, 

$strengthening dispersoid >> 2 !

    CONSTITUENT Y2TI2O7  :Y : TI : O :  !

PARAMETER G(Y2TI2O7,Y:TI:O;

 -365000+70*T;




$

 PHASE O1_GAS % 1  1.0 ! $ for thermodynamic properties calculations only >> 0 !

    CONSTITUENT O1_GAS :O : !

PARAMETER G(O1_GAS,O;

 273.00 GHSEROO#;




$###########################################################################

$                   THERMODYNAMIC PARAMETERS: M2P   

$###########################################################################



  PHASE M2P %  2 2   1 ! $ >> 1 !

    CONSTITUENT M2P : CR,FE,NB,TI : P : !

PARAMETER G(M2P,CR:P;

  -1.9695*T*LN(T);


PARAMETER G(M2P,FE:P;

  -1.9695*T*LN(T);


PARAMETER G(M2P,NB:P;

  -230400+60*T;


PARAMETER G(M2P,TI:P;

  -363800+78*T;


PARAMETER L(M2P,CR,FE:P;


PARAMETER L(M2P,FE,NB:P;




$###########################################################################

$                   THERMODYNAMIC PARAMETERS: M3P   

$###########################################################################



  PHASE M3P %  2 3   1 ! $ >> 1 !

    CONSTITUENT M3P : CR,FE,NB,TI : P : !

PARAMETER G(M3P,CR:P;

  +7.9518*T*LN(T);


PARAMETER G(M3P,FE:P;

  -1.9695*T*LN(T);


PARAMETER G(M3P,NB:P;

  -314800+80*T;


PARAMETER G(M3P,TI:P;

  -380000+90*T;


PARAMETER L(M3P,CR,FE:P;

