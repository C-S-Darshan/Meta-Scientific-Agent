   +GHSERVV#+GHSERNN#;


PARAMETER G(ZET,CR:V:VA;


PARAMETER G(ZET,FE:MO:N;


PARAMETER G(ZET,FE:MO:VA;


PARAMETER G(ZET,FE:NB:N;

   +GHSERNB#+GHSERNN#;


PARAMETER G(ZET,FE:NB:VA;


PARAMETER G(ZET,FE:V:N;

   +GHSERVV#+GHSERNN#;


PARAMETER G(ZET,FE:V:VA;


$----------------------Interaction parameters----------------------

PARAMETER L(ZET,CR:MO,NB:N;


PARAMETER L(ZET,CR:NB:N,VA;


PARAMETER L(ZET,CR:V:N,VA;


PARAMETER L(ZET,CR,FE:NB:N;


PARAMETER L(ZET,CR,FE:V:N;


PARAMETER L(ZET,FE:V:N,VA;


