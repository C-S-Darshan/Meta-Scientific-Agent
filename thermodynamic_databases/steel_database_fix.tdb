    CONSTITUENT ZET  : CR%,FE : NB,MO,V : N%,VA :  !

PARAMETER G(ZET,CR:MO:N;


PARAMETER G(ZET,CR:MO:VA;


PARAMETER G(ZET,CR:NB:N;

   +GHSERNB#+GHSERNN#;


PARAMETER G(ZET,CR:NB:VA;


