$###########################################################################

$                   THERMODYNAMIC PARAMETERS: M6C

$###########################################################################

$

 PHASE M6C  %  4  2   2   2   1 ! 

$Mo,W-rich carbide, can contain significant amounts 

$of Cr and V. Equilibrium phase in steels with 

$relatively low Cr contents. Has a large unit cell. 

$Precipitation predominantly on grain boundaries, 

$also on lath boundaries and prior austenite grain boundaries. 

$>> 5 !

    CONSTITUENT M6C  : CO,FE,NI : CR,MO,W : CO,CR,FE,MO,NI,SI,V,W : C :  !

PARAMETER G(M6C,CO:MO:CO:C;

   +GHSERCC#-10000-77*T;


PARAMETER G(M6C,CO:MO:CR:C;

   +2*GHSERMO#+2*GHSERCR#+GHSERCC#-10000-77*T;


PARAMETER G(M6C,CO:MO:FE:C;

   +2*GHSERMO#+2*GHSERFE#+GHSERCC#-10000-77*T;


PARAMETER G(M6C,CO:MO:MO:C;

   +4*GHSERMO#+GHSERCC#-10000-77*T;


PARAMETER G(M6C,CO:MO:NI:C;

   +2*GHSERMO#+2*GHSERNI#+GHSERCC#;


PARAMETER G(M6C,CO:MO:SI:C;

   +2*GHSERMO#+2*GHSERSI#+GHSERCC#-270000;


PARAMETER G(M6C,CO:MO:V:C;

   +2*GHSERMO#+2*GHSERVV#+GHSERCC#-10000-77*T;


PARAMETER G(M6C,CO:MO:W:C;

   +4*GHSERMO#+GHSERCC#+UNDEF#;


